{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SP400 emulator (MSVC Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\windows\\Debug\\sp400.exe",
      "args": [
        "${input:serialPort}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "Windows: Build Debug"
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Windows serial port connected to the SP400 input",
      "default": "COM3"
    }
  ]
}
